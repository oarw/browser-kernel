+
+TEST_F(PasswordFeatureManagerImplTest, LocalGenerationFollowsSavingPreference) {
+  sync_service_.SetSignedOut();
+  pref_service_.SetBoolean(
+      password_manager::prefs::kCredentialsEnableService, true);
+  EXPECT_TRUE(password_feature_manager_.IsGenerationEnabled());
+  EXPECT_FALSE(password_feature_manager_.IsAccountStorageActive());
+
+  pref_service_.SetBoolean(
+      password_manager::prefs::kCredentialsEnableService, false);
+  EXPECT_FALSE(password_feature_manager_.IsGenerationEnabled());
+}
+
+TEST_F(PasswordFeatureManagerImplTest, LocalGenerationWithoutSyncService) {
+  password_manager::PasswordFeatureManagerImpl local_manager(
+      &pref_service_, &pref_service_, nullptr);
+  pref_service_.SetBoolean(
+      password_manager::prefs::kCredentialsEnableService, true);
+  EXPECT_TRUE(local_manager.IsGenerationEnabled());
+  pref_service_.SetBoolean(
+      password_manager::prefs::kCredentialsEnableService, false);
+  EXPECT_FALSE(local_manager.IsGenerationEnabled());
+}
+
+TEST_F(PasswordFeatureManagerImplTest, LocalGenerationRequiresPreferences) {
+  password_manager::PasswordFeatureManagerImpl no_preferences(
+      nullptr, nullptr, nullptr);
+  EXPECT_FALSE(no_preferences.IsGenerationEnabled());
 }
 
